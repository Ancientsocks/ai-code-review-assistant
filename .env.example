APP_NAME=AI Code Review Assistant
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-password
DATABASE_URL=postgresql+psycopg://review_user:replace-me@db:5432/code_review
CORS_ORIGINS=http://localhost:5173
MAX_CODE_CHARS=50000
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=INFO
